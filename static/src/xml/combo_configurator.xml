<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ComboConfiguratorPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//main" position="replace">
            <main class="body">
                <t t-foreach="props.product.combo_ids" t-as="comboId" t-key="comboId">
                    <t t-set="combo" t-value="pos.db.combo_by_id[comboId]"/>
                    <t t-call="tha_pos_combo_favorites.ComboChoiceTree"/>
                </t>
            </main>
        </xpath>
    </t>
    <t t-name="tha_pos_combo_favorites.ComboChoiceTree" owl="1">
        <div class="d-flex flex-column m-3 mb-4">
            <h3 class="me-auto mb-3" t-esc="combo.name"/>
            <div t-if="getChildren(combo).length" class="product-list d-grid gap-1">
                <div t-foreach="getChildren(combo)" t-as="child" t-key="child.id">
                    <button type="button" class="btn btn-outline-secondary text-start w-100"
                        t-att-class="{'active': isSelected(combo.id, child.id, true)}"
                        t-att-disabled="!canSelect(combo, child.id, true)"
                        t-on-click="() => this.onClickNestedCombo(combo, child)">
                        <span t-esc="child.name"/>
                        <span t-if="isSelected(combo.id, child.id, true)"
                            class="d-flex align-items-center gap-1 mt-2">
                            <small class="text-muted" t-esc="getNestedSelectionLabel(combo, child) + ':'"/>
                            <span class="badge bg-light text-dark border"
                                t-esc="getNestedSelectionSummary(combo, child)"/>
                        </span>
                    </button>
                    <button t-if="combo.tha_max_selection &gt; 1 &amp;&amp; isSelected(combo.id, child.id, true)"
                        type="button" class="btn btn-link btn-sm"
                        t-on-click="() => this.removeNestedCombo(combo, child)">Remove</button>
                </div>
            </div>
            <div t-if="getAvailableComboLines(combo).length" class="product-list d-grid gap-1">
                <t t-foreach="getAvailableComboLines(combo)" t-as="combo_line" t-key="combo_line.id">
                    <t t-set="product" t-value="pos.db.product_by_id[combo_line.product_id[0]]"/>
                    <button type="button" class="btn btn-outline-secondary text-start"
                        t-att-class="{'active': isSelected(combo.id, combo_line.id)}"
                        t-att-disabled="!canSelect(combo, combo_line.id)"
                        t-on-click="(ev) => this.onClickNestedProduct({product, combo, combo_line}, ev)">
                        <span t-esc="product.display_name"/>
                    </button>
                </t>
            </div>
        </div>
    </t>
</templates>
