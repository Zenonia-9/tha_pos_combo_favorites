<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_combo_form_nested" model="ir.ui.view">
        <field name="name">pos.combo.form.nested.choices</field>
        <field name="model">pos.combo</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_combo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='combo_line_ids']" position="before">
                <group>
                    <field name="tha_child_combo_ids" widget="many2many_tags"
                        domain="[('id', '!=', id)]"
                        options="{'no_create': True, 'no_create_edit': True}"
                        help="Select existing combo choices. A choice can contain both products and sub choices."/>
                    <field name="tha_max_selection"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
